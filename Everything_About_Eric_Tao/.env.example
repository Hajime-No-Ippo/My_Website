# SMTP credentials for the /api/contact route.
# All five values below are required — the route returns 500 "Email not configured"
# if any of them is missing. CONTACT_TO in particular has no fallback: mail is never
# sent to a default address.

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where contact form submissions are delivered.
CONTACT_TO=

# Optional. Defaults to SMTP_USER when unset.
CONTACT_FROM=
